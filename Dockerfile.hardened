FROM python:3.13.18-alpine3.24 AS builder

WORKDIR /build
COPY requirements.hardened.txt .

RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir -r requirements.hardened.txt

FROM python:3.13.18-alpine3.24 AS runtime

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN addgroup -g 10001 appuser \
    && adduser -D -H -u 10001 -G appuser appuser

COPY --from=builder /opt/venv /opt/venv
COPY app.py .

USER 10001:10001

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:5000/', timeout=3).close()"]

CMD ["gunicorn", "--bind=0.0.0.0:5000", "--worker-tmp-dir=/tmp", "app:app"]